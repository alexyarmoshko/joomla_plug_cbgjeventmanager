<?xml version="1.0" encoding="UTF-8"?>
<cbinstall version="1.0.0" type="plugin" group="user">
	<name>Yak Shaver CB GJ Event Manager</name>
	<author>Yak Shaver</author>
	<creationDate>2026-07</creationDate>
	<copyright>(C) 2026 Yak Shaver https://www.kayakshaver.com</copyright>
	<license>GNU General Public License version 2 or later</license>
	<authorEmail>me@kayakshaver.com</authorEmail>
	<description>Lets CB GroupJive group Moderators/Admins assign an event's owner from within the native event edit form, scoped per-group and without CB global-moderator rights. Requires Community Builder GroupJive with the GroupJive Events plugin.</description>
	<version>2.11.0</version>
	<release>0.1.1</release>
	<files>
		<filename plugin="cbgjeventmanager">cbgjeventmanager.php</filename>
		<filename>component.cbgjeventmanager.php</filename>
		<filename>cbgjeventmanager.xml</filename>
		<filename>index.html</filename>
		<foldername>language</foldername>
		<foldername>library</foldername>
		<foldername>media</foldername>
	</files>
	<params>
		<tabpane name="cbgjeventmanager">
			<tabpanetab label="CBGJEVENTMANAGER_TAB_GENERAL">
				<param name="enabled" type="yesno" default="1" label="CBGJEVENTMANAGER_PARAM_ENABLED_LABEL" description="CBGJEVENTMANAGER_PARAM_ENABLED_DESC" yes="CBGJEVENTMANAGER_OPTION_ENABLE" no="CBGJEVENTMANAGER_OPTION_DISABLE" />
				<param name="owner_assign_level" type="list" default="2" label="CBGJEVENTMANAGER_PARAM_OWNER_ASSIGN_LEVEL_LABEL" description="CBGJEVENTMANAGER_PARAM_OWNER_ASSIGN_LEVEL_DESC">
					<option value="2">CBGJEVENTMANAGER_OPTION_LEVEL_MODERATOR</option>
					<option value="3">CBGJEVENTMANAGER_OPTION_LEVEL_ADMIN</option>
				</param>
				<param name="picker_min_chars" type="int" default="2" size="5" label="CBGJEVENTMANAGER_PARAM_PICKER_MIN_CHARS_LABEL" description="CBGJEVENTMANAGER_PARAM_PICKER_MIN_CHARS_DESC" />
				<param name="picker_max_results" type="int" default="20" size="5" label="CBGJEVENTMANAGER_PARAM_PICKER_MAX_RESULTS_LABEL" description="CBGJEVENTMANAGER_PARAM_PICKER_MAX_RESULTS_DESC" />
			</tabpanetab>
		</tabpane>
	</params>
</cbinstall>
